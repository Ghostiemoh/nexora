# Cross-device sync. Both are optional: without them Nexora runs exactly as it
# always has, entirely on the device, and the account panel in Settings reports
# sync as unavailable rather than offering a sign-in that cannot work.
#
# Setup:
#   1. Create a Supabase project.
#   2. Apply supabase/migrations/0001_sync.sql (via `supabase db push` or the
#      SQL editor). It creates both tables with row level security enabled.
#   3. To offer "Continue with Google", enable the Google provider in
#      Supabase Auth and add your OAuth client. The consent screen needs
#      verification before production, which is not instant, so start it early.
#
# The anon key is designed to be public. Every table it can reach is protected
# by row level security keyed to auth.uid(), so it grants no access to anyone
# else's rows. It is not a secret, and it is not what protects your data:
# records are encrypted on the device before they are sent.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
